# Your Hatena user ID. `hatebu config set username <id>` stores the same thing
# in ~/.config/hatebu/credentials.json; this environment variable wins.
HATENA_USER=your_username

# Optional override for the feed URL. %s is replaced with the user ID.
# HATENA_BOOKMARK_RSS_URL=https://b.hatena.ne.jp/%s/bookmark.rss
